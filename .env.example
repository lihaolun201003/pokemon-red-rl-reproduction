# DeepSeek API / LLM agent configuration example.
# Copy to `.env` in the project root and fill in your own key.  NEVER commit `.env`.
#
# The key is read from the environment (or a local `.env`); it is never printed or
# written to logs, checkpoints or reports.
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# Optional overrides (defaults shown; all can also be passed on the CLI)
# ---------------------------------------------------------------------------
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# Cost control (USD).  The agent pauses safely when a limit is reached.
# LLM_AGENT_MAX_USD=2.0
# LLM_AGENT_MAX_USD_TOTAL=10.0
# LLM_AGENT_MAX_CALLS=3000
# LLM_AGENT_MAX_CALLS_PER_HOUR=240

# Thinking mode: disabled is cheaper/faster; enabled uses reasoning tokens.
# LLM_AGENT_THINKING=disabled

# Observation image sent to the model (nearest-neighbour upscale of the 160x144 screen).
# LLM_AGENT_IMAGE_SCALE=4
# LLM_AGENT_IMAGE_FORMAT=png

# Real-time viewer (set LLM_AGENT_NO_VIEWER=1 or pass --headless to disable).
# LLM_AGENT_VIDEO=

# Paths (advanced)
# LLM_AGENT_ROM=./local/PokemonRed.gb
# LLM_AGENT_STATE=./local/has_pokedex_nballs.state
# LLM_AGENT_MEMORY_ROOT=./llm_agent/memory
# LLM_AGENT_RUN_ROOT=./artifacts/llm_agent/runs

# ---------------------------------------------------------------------------
# Navigation v2 (visual localization + permanent grid/world maps)
# ---------------------------------------------------------------------------
# The navigation subsystem drives low-level movement in Python; DeepSeek only
# chooses what to explore / where to go.  Set enabled=0 to fall back to the
# legacy raw movement tools.
# LLM_AGENT_NAV_ENABLED=true
# LLM_AGENT_NAV_WORLD_ROOT=            # default: <run_dir>/navigation
# LLM_AGENT_NAV_MAX_EXPLORE_STEPS=500
# LLM_AGENT_NAV_MAX_EXPLORE_SECONDS=600
# LLM_AGENT_NAV_MAX_NAVIGATE_STEPS=300
# LLM_AGENT_NAV_MAP_PANEL=true         # live Tk map panel in the watch window
